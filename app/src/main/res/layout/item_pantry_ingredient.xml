<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/pantry_white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:contentPaddingBottom="12dp"
    app:contentPaddingLeft="16dp"
    app:contentPaddingRight="6dp"
    app:contentPaddingTop="12dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textIngredientName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Milk"
                android:textColor="@color/pantry_navy"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textIngredientQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="2 bottles"
                android:textColor="@color/pantry_teal"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textIngredientDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Dairy • Expiry: 20/10/2026"
                android:textColor="@color/pantry_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textIngredientAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEditIngredient"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Edit ingredient"
            android:padding="10dp"
            android:src="@drawable/ic_pantry_edit"
            android:tint="@color/pantry_teal" />

        <ImageButton
            android:id="@+id/btnDeleteIngredient"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete ingredient"
            android:padding="10dp"
            android:src="@drawable/ic_pantry_delete"
            android:tint="@color/pantry_danger" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
