<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pantry_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/pantry_navy"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="24dp"
            android:paddingEnd="22dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manage your ingredients"
                android:textColor="@color/pantry_white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Add an item or update the details below."
                android:textColor="@color/pantry_header_text"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ingredient name"
                android:textColor="@color/pantry_navy"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editIngredientName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/pantry_input_background"
                android:hint="e.g. Milk"
                android:inputType="textCapSentences"
                android:paddingHorizontal="14dp"
                android:textColor="@color/pantry_navy"
                android:textColorHint="@color/pantry_text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quantity"
                android:textColor="@color/pantry_navy"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editQuantity"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/pantry_input_background"
                android:hint="e.g. 10"
                android:inputType="numberDecimal"
                android:paddingHorizontal="14dp"
                android:textColor="@color/pantry_navy"
                android:textColorHint="@color/pantry_text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unit"
                android:textColor="@color/pantry_navy"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerUnit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/pantry_input_background"
                android:paddingHorizontal="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textColor="@color/pantry_navy"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/pantry_input_background"
                android:paddingHorizontal="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Expiry date"
                android:textColor="@color/pantry_navy"
                android:textStyle="bold" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExpiryDate"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="24dp"
                android:text="Choose expiry date (optional)"
                android:textAllCaps="false"
                android:textColor="@color/pantry_teal"
                app:strokeColor="@color/pantry_teal"
                app:strokeWidth="1dp" />

            <!-- Main action -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveIngredient"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="@color/pantry_teal"
                android:text="Save ingredient"
                android:textAllCaps="false"
                android:textColor="@color/pantry_white" />

            <!-- Least important action: plain text button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="@color/pantry_navy" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
